{
  "expo": {
    "name": "EVENTUALLY.VET",
    "slug": "eventually-vet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#1a1a2e",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventuallyvet.app",
      "infoPlist": {
        "NSCalendarsUsageDescription": "EVENTUALLY.VET needs calendar access to import your medical appointments.",
        "NSPhotoLibraryUsageDescription": "EVENTUALLY.VET needs photo access to attach images to your records."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.eventuallyvet.app",
      "permissions": ["READ_CALENDAR", "WRITE_CALENDAR", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-calendar",
      "expo-document-picker",
      "expo-image-picker"
    ]
  }
}
