# ============================================================================
# EVENTUALLY.VET - Environment Variables
# Copy this to .env and fill in your Supabase project values
# ============================================================================

# Supabase Project URL (from supabase.com/dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (from Settings → API → anon/public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (NEVER expose in client - backend only)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
